{
  "name": "@zhixing/owner-services",
  "version": "0.1.0",
  "description": "知行 owner 领域服务 — 推进控制、审查调度与恢复维护",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advancement": {
      "types": "./dist/advancement/index.d.ts",
      "import": "./dist/advancement/index.js"
    },
    "./advancement/controller": {
      "types": "./dist/advancement/controller.d.ts",
      "import": "./dist/advancement/controller.js"
    },
    "./advancement/proxy-content": {
      "types": "./dist/advancement/proxy-content.d.ts",
      "import": "./dist/advancement/proxy-content.js"
    },
    "./advancement/proxy-scheduler": {
      "types": "./dist/advancement/proxy-scheduler.d.ts",
      "import": "./dist/advancement/proxy-scheduler.js"
    },
    "./advancement/recovery-maintenance": {
      "types": "./dist/advancement/recovery-maintenance.d.ts",
      "import": "./dist/advancement/recovery-maintenance.js"
    },
    "./advancement/review-application-bridge": {
      "types": "./dist/advancement/review-application-bridge.d.ts",
      "import": "./dist/advancement/review-application-bridge.js"
    },
    "./advancement/review-attempt-correctness": {
      "types": "./dist/advancement/review-attempt-correctness.d.ts",
      "import": "./dist/advancement/review-attempt-correctness.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zhixing/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/longxia/zhixing.git",
    "directory": "packages/owner-services"
  },
  "publishConfig": {
    "access": "public"
  }
}
