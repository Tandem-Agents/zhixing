{
  "name": "@zhixing/mesh",
  "version": "0.1.0",
  "description": "知行设备网格 — 双向认证、安全会话、出站隧道与盲中继基座",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js"
    },
    "./blind-relay": {
      "types": "./dist/blind-relay.d.ts",
      "import": "./dist/blind-relay.js"
    },
    "./device-identity": {
      "types": "./dist/device-identity.d.ts",
      "import": "./dist/device-identity.js"
    },
    "./handshake": {
      "types": "./dist/handshake.d.ts",
      "import": "./dist/handshake.js"
    },
    "./outbound-tunnel": {
      "types": "./dist/outbound-tunnel.d.ts",
      "import": "./dist/outbound-tunnel.js"
    },
    "./replay-window": {
      "types": "./dist/replay-window.d.ts",
      "import": "./dist/replay-window.js"
    },
    "./service-registry": {
      "types": "./dist/service-registry.d.ts",
      "import": "./dist/service-registry.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@peculiar/webcrypto": "^1.5.0",
    "@peculiar/x509": "^2.0.0",
    "@zhixing/core": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
