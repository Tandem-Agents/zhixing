        {
          "at": 398,
          "remove": 0,
          "insert": [
            "    }",
            "",
            "    /// Replaced atomically; callers republish after every content edit/undo/redo.",
            "    /// A stale content epoch is ignored, so offsets never attach to edited text.",
            "    pub fn setNoBreakRanges(self: *Self, ranges: []const NoBreakRange) bool {",
            "        if (ranges.len > max_no_break_ranges) return false;",
            "        var previous_end: u32 = 0;",
            "        for (ranges) |range| {",
            "            if (range.start < previous_end or range.end <= range.start or range.end > self.text_buffer.textEndOffset()) return false;",
            "            const start = iter_mod.offsetToCoords(self.text_buffer.rope(), range.start) orelse return false;",
            "            const last = iter_mod.offsetToCoords(self.text_buffer.rope(), range.end - 1) orelse return false;",
            "            if (start.row != last.row) return false;",
            "            const start_bounds = self.text_buffer.graphemeBoundsAtOffset(range.start) orelse return false;",
            "            const end_bounds = self.text_buffer.graphemeBoundsAtOffset(range.end - 1) orelse return false;",
            "            if (start_bounds.start != range.start or end_bounds.end != range.end) return false;",
            "            previous_end = range.end;",
            "        }",
            "        const replacement = self.global_allocator.dupe(NoBreakRange, ranges) catch return false;",
            "        self.global_allocator.free(self.no_break_ranges);",
            "        self.no_break_ranges = replacement;",
            "        self.no_break_epoch = self.text_buffer.getContentEpoch();",
            "        self.virtual_lines_dirty = true;",
            "        self.cached_measure_result = null;",
            "        self.truncation_applied = false;",
            "        return true;",
            "    }",
            "",
            "    fn activeNoBreakRanges(self: *const Self) []const NoBreakRange {",
            "        return if (self.no_break_epoch == self.text_buffer.getContentEpoch()) self.no_break_ranges else &.{};"
          ]
        },
