        {
          "at": 159,
          "remove": 0,
          "insert": [
            "test \"synchronous current frame write finishes before success\" {",
            "    var memory = MemoryOutput.init(std.testing.allocator);",
            "    defer memory.deinit();",
            "    var backend = try BufferedBackend.create(std.testing.allocator, memory.bufferedOutput());",
            "    defer backend.deinit();",
            "    try std.testing.expect(!backend.isUseThread());",
            "    backend.beginFrame();",
            "    try backend.writer().writeAll(\"current frame\");",
            "    try std.testing.expectEqual(WriteStatus.ok, backend.endFrame());",
            "    try std.testing.expectEqualStrings(\"current frame\", memory.bytes.items);",
            "}",
            "",
            "test \"Windows current frame write failure cannot commit success\" {",
            "    if (builtin.os.tag != .windows) return error.SkipZigTest;",
            "    var backend = try BufferedBackend.createStdout(std.testing.allocator);",
            "    defer backend.deinit();",
            "    const output = backend.ownedStdoutOutput.?;",
            "    output.stdout.handle = std.os.windows.INVALID_HANDLE_VALUE;",
            "    output.windowsConsole = true;",
            "    backend.beginFrame();",
            "    try backend.writer().writeAll(\"failed current frame\");",
            "    try std.testing.expectEqual(WriteStatus.failed, backend.endFrame());",
            "    try std.testing.expect(output.failed.load(.acquire));",
            "    try std.testing.expect(!backend.hasCommittedFrame);",
            "}",
            "",
            "test \"Windows malformed current frame cannot commit success\" {",
            "    if (builtin.os.tag != .windows) return error.SkipZigTest;",
            "    var backend = try BufferedBackend.createStdout(std.testing.allocator);",
            "    defer backend.deinit();",
            "    backend.ownedStdoutOutput.?.windowsConsole = true;",
            "    backend.beginFrame();",
            "    try backend.writer().writeAll(\"\\xFF\");",
            "    try std.testing.expectEqual(WriteStatus.failed, backend.endFrame());",
            "    try std.testing.expect(!backend.hasCommittedFrame);",
            "}",
            ""
          ]
        },
