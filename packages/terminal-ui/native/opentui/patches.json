            "export fn editorViewSetNoBreakRanges(view_handle: NativeHandle, ranges: ?[*]const text_buffer_view.NoBreakRange, count: u32) bool {",
            "    const object_ptr = acquireEditorView(view_handle) orelse return false;",
            "    if (count > text_buffer_view.max_no_break_ranges) return false;",
            "    const input: []const text_buffer_view.NoBreakRange = if (count == 0) &.{} else (ranges orelse return false)[0..count];",
            "    if (!object_ptr.getTextBufferView().setNoBreakRanges(input)) return false;",
            "    object_ptr.makeCursorVisible();",
            "    return true;",
            "}",
            ""
