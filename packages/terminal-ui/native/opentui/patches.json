            "test \"Zhixing atomic wrap preserves raw input cursor and copied selection\" {",
            "    const pool = gp.initGlobalPool(std.testing.allocator);",
            "    defer gp.deinitGlobalPool();",
            "    const links = link.initGlobalLinkPool(std.testing.allocator);",
            "    defer link.deinitGlobalLinkPool();",
            "    const eb = try EditBuffer.init(std.testing.allocator, pool, links, .unicode, null);",
            "    defer eb.deinit();",
            "    const ev = try EditorView.init(std.testing.allocator, eb, 8, 8);",
            "    defer ev.deinit();",
            "    const text = \"12345[A B]z\";",
            "    try eb.insertText(text);",
            "    ev.setWrapMode(.char);",
            "    try std.testing.expect(ev.getTextBufferView().setNoBreakRanges(&.{.{ .start = 5, .end = 10 }}));",
            "    var raw: [64]u8 = undefined;",
            "    try std.testing.expectEqualStrings(text, raw[0..ev.getText(&raw)]);",
            "    ev.setSelection(5, 10, null, null);",
            "    var copy: [64]u8 = undefined;",
            "    try std.testing.expectEqualStrings(\"[A B]\", copy[0..ev.getSelectedTextIntoBuffer(&copy)]);",
            "    try ev.setCursorByOffset(5);",
