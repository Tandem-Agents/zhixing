            "/// Document display-cell offsets, including one weight for each hard newline.",
            "/// Presentation only: never changes the underlying EditBuffer or copied text.",
            "pub const NoBreakRange = extern struct { start: u32, end: u32 };",
            "pub const max_no_break_ranges: usize = 65536;"
          ]
