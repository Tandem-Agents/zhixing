        {
          "at": 4922,
          "remove": 0,
          "insert": [
            "",
            "test \"Zhixing atomic ranges wrap as one unit with render and measurement parity\" {",
            "    const pool = gp.initGlobalPool(std.testing.allocator);",
            "    defer gp.deinitGlobalPool();",
            "    const links = link.initGlobalLinkPool(std.testing.allocator);",
            "    defer link.deinitGlobalLinkPool();",
            "    const tb = try TextBuffer.init(std.testing.allocator, pool, links, .unicode);",
            "    defer tb.deinit();",
            "    const view = try TextBufferView.init(std.testing.allocator, tb);",
            "    defer view.deinit();",
            "    // Deliberate rope fragmentation through the token.",
            "    try tb.append(\"12345[A\");",
            "    try tb.append(\" B]z\");",
            "    view.setWrapMode(.char);",
            "    view.setWrapWidth(8);",
            "    _ = try view.measureForDimensions(8, 10); // Seed the old measure cache.",
            "    try std.testing.expect(view.setNoBreakRanges(&.{.{ .start = 5, .end = 10 }}));",
            "    const lines = view.getVirtualLines();",
            "    try std.testing.expectEqual(@as(usize, 2), lines.len);",
            "    try std.testing.expectEqual(@as(u32, 5), lines[0].width_cols);",
            "    try std.testing.expectEqual(@as(u32, 5), lines[1].document_cell_offset);",
            "    try std.testing.expectEqual(@as(u32, 6), lines[1].width_cols);",
            "    const measure = try view.measureForDimensions(8, 10);",
            "    try std.testing.expectEqual(@as(u32, 2), measure.line_count);",
            "    try std.testing.expectEqual(@as(u32, 6), measure.width_cols_max);",
            "    // Overwide token moves to a fresh row and falls back without truncation.",
            "    view.setWrapWidth(4);",
            "    const narrow = view.getVirtualLines();",
            "    try std.testing.expectEqual(@as(usize, 4), narrow.len);",
            "    try std.testing.expectEqual(@as(u32, 5), narrow[2].document_cell_offset);",
            "    try std.testing.expectEqual(@as(u32, 4), narrow[2].width_cols);",
            "    try std.testing.expectEqual(@as(u32, 2), narrow[3].width_cols);",
            "    view.setWrapWidth(11);",
            "    try std.testing.expectEqual(@as(u32, 1), view.getVirtualLineCount());",
            "    view.setWrapWidth(8);",
            "    try std.testing.expect(view.setNoBreakRanges(&.{}));",
            "    try std.testing.expectEqual(@as(u32, 8), view.getVirtualLines()[0].width_cols);",
            "}",
            "",
            "test \"Zhixing atomic ranges use document cells across CJK combining and hard newline\" {",
            "    const pool = gp.initGlobalPool(std.testing.allocator);",
            "    defer gp.deinitGlobalPool();",
            "    const links = link.initGlobalLinkPool(std.testing.allocator);",
            "    defer link.deinitGlobalLinkPool();",
            "    const tb = try TextBuffer.init(std.testing.allocator, pool, links, .unicode);",
            "    defer tb.deinit();",
            "    const view = try TextBufferView.init(std.testing.allocator, tb);",
            "    defer view.deinit();",
            "    try tb.setText(\"x\\n\\u{754c}e\\u{301}[A B]z\");",
            "    view.setWrapMode(.char);",
            "    view.setWrapWidth(7);",
            "    // x + newline + CJK(2) + e/combining(1) => 5; token width is 5.",
            "    try std.testing.expect(view.setNoBreakRanges(&.{.{ .start = 5, .end = 10 }}));",
            "    const lines = view.getVirtualLines();",
            "    try std.testing.expectEqual(@as(usize, 3), lines.len);",
            "    try std.testing.expectEqual(@as(u32, 3), lines[1].width_cols);",
            "    try std.testing.expectEqual(@as(u32, 5), lines[2].document_cell_offset);",
            "    try std.testing.expectEqual(@as(u32, 6), lines[2].width_cols);",
            "    try std.testing.expect(!view.setNoBreakRanges(&.{.{ .start = 0, .end = 6 }}));",
            "    try std.testing.expect(!view.setNoBreakRanges(&.{.{ .start = 5, .end = 10 }, .{ .start = 6, .end = 10 }}));",
            "    // Edits invalidate old coordinates; they cannot silently mark new content.",
            "    try tb.setText(\"123456789\");",
            "    try std.testing.expectEqual(@as(u32, 7), view.getVirtualLines()[0].width_cols);",
            "}",
            ""
          ]
        }
