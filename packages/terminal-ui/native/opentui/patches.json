            "    try std.testing.expectEqual(@as(u32, 1), visual.visual_row);",
            "    try std.testing.expectEqual(@as(u32, 0), visual.visual_col);",
            "    ev.setViewportSize(4, 8);",
            "    try std.testing.expectEqualStrings(text, raw[0..ev.getText(&raw)]);",
            "    try std.testing.expectEqualStrings(\"[A B]\", copy[0..ev.getSelectedTextIntoBuffer(&copy)]);",
            "}",
