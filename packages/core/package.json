    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./authority": {
      "types": "./dist/authority/index.d.ts",
      "import": "./dist/authority/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "import": "./dist/delivery/index.js"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "import": "./dist/environment/index.js"
    },
    "./test-support/s7-durable": {
      "types": "./dist/test-support/s7-durable.d.ts",
      "import": "./dist/test-support/s7-durable.js"
    },
    "./test-support/s7-durable-harness": {
      "types": "./dist/test-support/s7-durable-harness.d.ts",
      "import": "./dist/test-support/s7-durable-harness.js"
