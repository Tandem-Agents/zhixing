  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "lint:contract-schemas": "node ../../scripts/lint-distributed-runtime-contracts.mjs && tsc -p tsconfig.contracts.schema.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@zhixing/test-utils": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "cron-parser": "5.5.0",
    "fuse.js": "7.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/longxia/zhixing.git",
