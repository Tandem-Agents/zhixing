{
  "name": "@zhixing/server",
  "version": "0.1.0",
  "description": "知行常驻服务网关 — HTTP + WebSocket + JSON-RPC 2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zhixing/core": "workspace:*",
    "@zhixing/owner-kernel": "workspace:*",
    "@zhixing/owner-services": "workspace:*",
    "@zhixing/rpc": "workspace:*",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "@zhixing/test-utils": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/longxia/zhixing.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  }
