{
  "name": "zhixing",
  "version": "0.1.0",
  "private": true,
  "description": "知行 — 智能体引擎",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm release:version:check && pnpm -r run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "runtime:baseline": "node scripts/runtime-baseline.mjs",
    "runtime:baseline:update": "node scripts/runtime-baseline.mjs --update",
    "runtime:package-exports": "node scripts/check-runtime-package-exports.mjs",
    "release:version:check": "node scripts/release-version.mjs",
    "release:version:sync": "node scripts/release-version.mjs --write",
    "release:channel:embed": "node scripts/release-channel.mjs",
    "release:artifact": "node scripts/build-release-artifact.mjs",
    "release:tooling:test": "node --test scripts/release-tooling.test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "contracts:typecheck": "pnpm --filter @zhixing/core typecheck:contracts",
    "contracts:lint": "pnpm --filter @zhixing/core lint:contract-schemas",
    "security:supply-chain": "node scripts/check-mesh-security-supply-chain.mjs",
    "security:mesh-test-clock": "node scripts/check-mesh-live-tls-tests.mjs",
    "security:secrets": "node scripts/check-secret-boundaries.mjs",
    "s7:registry-golden": "node --import=tsx/esm scripts/s7-registry-golden.mjs --check",
    "s7:registry-golden:write": "node --import=tsx/esm scripts/s7-registry-golden.mjs --write",
    "s7:lint": "node --import=tsx/esm scripts/s7-entry-coverage.mjs && node --import=tsx/esm --test scripts/s7-entry-coverage.test.mjs && pnpm s7:registry-golden",
    "lint": "pnpm security:supply-chain && pnpm security:mesh-test-clock && pnpm security:secrets && pnpm s7:lint && biome check .",
    "lint:fix": "biome check --write .",
    "clean": "pnpm -r run clean",
    "playground": "node --import=tsx/esm playground/chat.ts",
    "cli": "node --import=tsx/esm packages/cli/src/index.ts",
    "cli:build": "pnpm --filter @zhixing/cli build",
    "serve": "node --import=tsx/esm packages/cli/src/index.ts serve"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "tsx": "^4.21.0"
  }
}
